# Copy this file to .env, fill in the values, then run:
#   docker compose up -d --build
#
# NEXT_PUBLIC_* values are compiled into the browser bundle at build time.
# After changing one, rebuild with:
#   docker compose up -d --build

# Supabase project URL and publishable key (safe for the browser).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Supabase secret key. Server only. Never expose this to the browser.
SUPABASE_SECRET_KEY=sb_secret_your_key

# Public URL where this container will be reached.
# Use http://localhost:3000 for local Docker, or your real https domain behind a proxy.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: host port. Change if port 3000 is already taken.
# APP_PORT=3000

# Optional: Google sign-in client ID.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Optional: repository link shown in self-host CTAs.
# NEXT_PUBLIC_GITHUB_URL=https://github.com/your-user/your-repo

# Optional: superadmin dashboard access. Comma-separated emails.
# SUPERADMIN_EMAILS=you@example.com

# Optional: distributed rate limiting.
# UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Optional: dedicated secret for signed receipt share links.
# RECEIPT_SIGNING_SECRET=generate-a-long-random-string
