# Stable Server Action IDs across dev restarts (generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=your-base64-key-here

# ── Deployment mode ─────────────────────────────────────────────────────────
# Cloud (default when unset): hosted plan, PDF/print locked until a Cloud pass is active.
# Self-hosted: set NEXT_PUBLIC_SELF_HOSTED=true to unlock every feature for free.
# NEXT_PUBLIC_SELF_HOSTED=true
# Optional explicit switch (false disables billing without renaming the edition):
# NEXT_PUBLIC_CLOUD_BILLING_ENABLED=false

# Vercel Cron secret for the daily Supabase keepalive request.
# Set this in Vercel; Vercel sends it automatically as a Bearer token.
# CRON_SECRET=generate-a-long-random-string

# Public repository link used by pricing and "self-host" CTAs
# NEXT_PUBLIC_GITHUB_URL=https://github.com/thekailashchandra/freelancerinvoice

# Supabase - Dashboard → Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Publishable key (sb_publishable_...) - safe for browser & cookie-based SSR
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Secret key (sb_secret_...) - server only, never expose to the client
SUPABASE_SECRET_KEY=your-secret-key

# Ko-fi - optional voluntary support link (supportTipUrl in data/site.ts)

# Dodo Payments - international USD passes (30-day and 365-day)
# Create one-time products in Dodo priced at $5 and $19, then add their IDs.
# Use test_mode locally and live_mode on the production deployment.
# DODO_PAYMENTS_API_KEY=your-dodo-api-key
# DODO_PAYMENTS_WEBHOOK_KEY=your-dodo-webhook-key
# DODO_PAYMENTS_ENVIRONMENT=test_mode
# DODO_PAYMENTS_PRODUCT_ID_MONTHLY=pdt_xxxxxxxxxxxxxxxxx
# DODO_PAYMENTS_PRODUCT_ID_YEARLY=pdt_xxxxxxxxxxxxxxxxx

# Razorpay - platform keys for the hosted Cloud plan in India (INR 299/month or 999/year)
# Only needed on the cloud deployment. Self-hosted builds can leave these blank.
# NEXT_PUBLIC_RAZORPAY_ENABLED=true
# App login email allowed to see Razorpay UI (NOT your Razorpay merchant login - your app sign-in email)
# RAZORPAY_OWNER_EMAIL=you@example.com

# Platform API keys from your BUSINESS Razorpay merchant account (Dashboard → API Keys → Live)
# Used for Cloud passes - server only, never expose to browser
# RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
# RAZORPAY_KEY_SECRET=your-live-secret

# Invoice payments (owner preview): add Live keys in Settings when signed in as RAZORPAY_OWNER_EMAIL
# Public /pay links for freelancer invoice collection - off by default (invoice creation only).
# NEXT_PUBLIC_INVOICE_PAYMENTS_ENABLED=true
# RAZORPAY_WEBHOOK_SECRET=whsec_from_razorpay_dashboard

# App URL for auth redirects (production / Vercel only - dev always uses localhost:3000)
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Google AdSense publisher ID (also used for Funding Choices / Google CMP)
# NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX

# Google Analytics 4 measurement ID (Admin → Data streams → Web)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Search Console - HTML tag verification (Settings → Ownership verification)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-verification-token

# Google sign-in - same Client ID as Supabase → Authentication → Providers → Google
# Shows "Invoice for Freelance" on the Google consent screen (not the Supabase URL)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Support request email delivery (SMTP)
# SUPPORT_SMTP_HOST=smtp.gmail.com
# SUPPORT_SMTP_PORT=587
# SUPPORT_SMTP_USER=you@example.com
# SUPPORT_SMTP_PASS=your-app-password
# SUPPORT_FROM_EMAIL=you@example.com
# SUPPORT_TO_EMAIL=you@example.com

# Rate limiting (recommended for production - https://upstash.com)
# Without these, limits use in-memory storage (per server instance only).
# UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Local dev only: country for legal consent when IP geo is unavailable (e.g. localhost)
# DEV_CONSENT_COUNTRY=IN

# Optional dedicated secret for signed receipt share links (defaults to SUPABASE_SECRET_KEY).
# RECEIPT_SIGNING_SECRET=generate-a-long-random-string

# Superadmin dashboard at /admin - app sign-in email(s), comma-separated (server only)
# NOT the Razorpay merchant email - whichever email you use to log into this app
# SUPERADMIN_EMAILS=you@example.com

# Umami open-source analytics (optional - https://umami.is)
# Client tracking script:
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=your-website-uuid
# NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://your-umami-host/script.js
# Superadmin API pull (same website):
# UMAMI_API_URL=https://your-umami-host
# UMAMI_WEBSITE_ID=your-website-uuid
# Self-hosted: login credentials (no API keys in the UI)
# UMAMI_USERNAME=admin
# UMAMI_PASSWORD=your-umami-password
# Umami Cloud only:
# UMAMI_API_TOKEN=your-umami-api-token
