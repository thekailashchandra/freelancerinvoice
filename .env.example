# Stable Server Action IDs across dev restarts (generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=your-base64-key-here

# Supabase — Dashboard → Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Publishable key (sb_publishable_...) — safe for browser & cookie-based SSR
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Secret key (sb_secret_...) — server only, never expose to the client
SUPABASE_SECRET_KEY=your-secret-key

# Ko-fi — premium template unlocks and invoice tip link (supportTipUrl in data/site.ts)

# Razorpay — set NEXT_PUBLIC_RAZORPAY_ENABLED=true after verification + DB migrations
# NEXT_PUBLIC_RAZORPAY_ENABLED=false
# RAZORPAY_DEMO_MODE=true
# RAZORPAY_PLATFORM_KEY_ID=rzp_test_xxxxxxxx
# RAZORPAY_PLATFORM_KEY_SECRET=your-test-secret
# RAZORPAY_WEBHOOK_SECRET=whsec_from_razorpay_dashboard

# App URL for auth redirects (production / Vercel only — dev always uses localhost:3000)
# NEXT_PUBLIC_SITE_URL=https://www.invoiceforfreelance.com

# Google AdSense publisher ID (also used for Funding Choices / Google CMP)
# NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-1406068437280536

# Google sign-in — same Client ID as Supabase → Authentication → Providers → Google
# Shows "Invoice for Freelance" on the Google consent screen (not the Supabase URL)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Support request email delivery (SMTP)
# SUPPORT_SMTP_HOST=smtp.gmail.com
# SUPPORT_SMTP_PORT=587
# SUPPORT_SMTP_USER=invoiceforfreelance@gmail.com
# SUPPORT_SMTP_PASS=your-app-password
# SUPPORT_FROM_EMAIL=invoiceforfreelance@gmail.com
# SUPPORT_TO_EMAIL=invoiceforfreelance@gmail.com
