# Supabase — Dashboard → Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Publishable key (sb_publishable_...) — safe for browser & cookie-based SSR
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Secret key (sb_secret_...) — server only, never expose to the client
SUPABASE_SECRET_KEY=your-secret-key

# App URL for auth redirects (production / Vercel only — dev always uses localhost:3000)
# NEXT_PUBLIC_SITE_URL=https://www.invoiceforfreelance.com

# Google sign-in — same Client ID as Supabase → Authentication → Providers → Google
# Shows "Invoice for Freelance" on the Google consent screen (not the Supabase URL)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Support request email delivery (SMTP)
# SUPPORT_SMTP_HOST=smtp.gmail.com
# SUPPORT_SMTP_PORT=587
# SUPPORT_SMTP_USER=invoiceforfreelance@gmail.com
# SUPPORT_SMTP_PASS=your-app-password
# SUPPORT_FROM_EMAIL=invoiceforfreelance@gmail.com
# SUPPORT_TO_EMAIL=invoiceforfreelance@gmail.com
