{
  "name": "invoice-tool",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source monochrome invoicing studio for freelancers with Cloud billing and self-hosting.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/thekailashchandra/freelancerinvoice.git"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "node scripts/free-port.js 3000 && node scripts/ensure-dev-cache.js && node scripts/write-dev-build-id.js && next dev --turbopack -p 3000",
    "dev:turbo": "node scripts/free-port.js 3000 && node scripts/ensure-dev-cache.js && node scripts/write-dev-build-id.js && next dev --turbopack -p 3000",
    "dev:webpack": "node scripts/free-port.js 3000 && node scripts/ensure-dev-cache.js && node scripts/write-dev-build-id.js && next dev -p 3000",
    "dev:clean": "node scripts/free-port.js 3000 && node scripts/clean-next.js && node scripts/write-dev-build-id.js && next dev --turbopack -p 3000",
    "clean": "node scripts/clean-next.js",
    "generate-favicons": "npx tsx scripts/generate-favicons.ts",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint ."
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.14",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.2",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dodopayments": "^2.55.0",
    "framer-motion": "^12.16.0",
    "geist": "^1.7.2",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.513.0",
    "next": "^16.4.2",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.1.6",
    "qrcode.react": "^4.2.0",
    "razorpay": "^2.9.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.35.5",
    "sonner": "^2.0.5",
    "standardwebhooks": "^1.1.1",
    "tailwind-merge": "^3.3.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.8",
    "@types/node": "^22.15.29",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "eslint": "^9.28.0",
    "eslint-config-next": "^16.4.2",
    "png-to-ico": "^3.0.1",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.8.3"
  }
}
